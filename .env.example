# Copy to .env.local and fill in. Never commit real values.

# Supabase (from `supabase start` locally, or the project dashboard)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Students must sign in with an address on this domain (no @), e.g. college.edu
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=college.edu

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL, e.g. mailto:canteen@college.edu
VAPID_SUBJECT=mailto:canteen@college.edu
