# Copy to .env.local and fill in. Never commit real values.

# Supabase (from `supabase start` locally, or the project dashboard)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact URL, e.g. mailto:canteen@college.edu
VAPID_SUBJECT=mailto:canteen@college.edu

# Presentation fallback: lets a demo student sign in at /demo-login. Leave unset in production.
# DEMO_LOGIN=true

# AI assistant (server only). Without a key the assistant uses the built-in rules engine.
GEMINI_API_KEY=
# Gemini model id used for suggestions.
GEMINI_MODEL=gemini-flash-latest
