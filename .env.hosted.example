# Demo accounts on the HOSTED Supabase project (the one the Vercel site uses).
# Copy this file to .env.hosted.local, fill in the three values, then run:  npm run demo:hosted
# .env.hosted.local is git-ignored. Never commit real values.

# Supabase dashboard -> Project Settings -> API (the same values you gave Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The password for demo.student and demo.staff on the hosted site, at least 6 characters.
# Anyone who knows it can sign in, and demo.staff can see student phone numbers:
# share it only with the people at the demo, and turn DEMO_LOGIN off on Vercel afterwards.
DEMO_PASSWORD=

# Set to 1 to also create demo.admin on the hosted project.
# DEMO_WITH_ADMIN=1
